#version 450
#define G 6.67430e-3
#define TILE_SIZE 128

layout(local_size_x = TILE_SIZE) in;

struct dustBody
{
    vec4 position;
    vec4 velocity;
    vec4 acceleration;
    float radius;
    float mass;
    float _pad0;
    float _pad1;
};

layout(std430, binding = 1) buffer DustSim {
    dustBody particles[];
};

uniform float u_Softening;
uniform float u_MaxAccel;
uniform uint  u_ParticleCount;

shared vec4  shPos[TILE_SIZE];
shared float shMass[TILE_SIZE];
shared float shRadius[TILE_SIZE];

void main()
{
    uint id      = gl_GlobalInvocationID.x;
    uint localId = gl_LocalInvocationID.x;

    bool isAlive = (id < u_ParticleCount) && (particles[id].mass > 0.0);

    vec3 acc = vec3(0.0);
    vec3 pos = isAlive ? particles[id].position.xyz : vec3(0.0);
    float myRadius = isAlive ? particles[id].radius : 0.0;

    uint tiles = (u_ParticleCount + TILE_SIZE - 1) / TILE_SIZE;

    for (uint tile = 0; tile < tiles; ++tile)
    {
        uint idx = tile * TILE_SIZE + localId;

        if (idx < u_ParticleCount)
        {
            shPos[localId]    = particles[idx].position;
            shMass[localId]   = particles[idx].mass;
            shRadius[localId] = particles[idx].radius;
        }
        else
        {
            shMass[localId] = 0.0;
        }

        barrier();

        if (isAlive)
        {
            for (uint j = 0; j < TILE_SIZE; ++j)
            {
                uint otherId = tile * TILE_SIZE + j;
                if (otherId == id) continue;

                float m2 = shMass[j];
                if (m2 <= 0.0) continue;

                vec3 r = shPos[j].xyz - pos;
                float soft = max(shRadius[j] + myRadius, u_Softening);
                float invR = inversesqrt(dot(r,r) + soft*soft);
                acc += G * m2 * r * invR * invR * invR;
            }
        }

        barrier();
    }

    if (isAlive)
    {
        float aMag = length(acc);
        if (aMag > u_MaxAccel)
            acc *= u_MaxAccel / aMag;

        particles[id].acceleration.xyz = acc;
    }
}
