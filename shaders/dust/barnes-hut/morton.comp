#version 450
#include "bh_structs.compinc"

layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer Particles {
    Particle particles[];
};

layout(std430, binding = 6) buffer MortonOut {
    uint mortonKeys[];
};

uniform vec3 u_MinBounds;
uniform vec3 u_MaxBounds;
uniform uint u_ParticleCount;

uint expandBits(uint v)
{
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint morton3D(vec3 pos)
{
    vec3 norm = (pos - u_MinBounds) / (u_MaxBounds - u_MinBounds);
    norm = clamp(norm, 0.0, 0.999);

    uint x = uint(norm.x * 1024.0);
    uint y = uint(norm.y * 1024.0);
    uint z = uint(norm.z * 1024.0);

    return (expandBits(x) << 2) |
           (expandBits(y) << 1) |
           (expandBits(z));
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= u_ParticleCount) return;

    mortonKeys[id] = morton3D(particles[id].position.xyz);
}
